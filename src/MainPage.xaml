<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:zxing="clr-namespace:ZXing.Net.Maui.Controls;assembly=ZXing.Net.Maui.Controls"
    x:Class="QRCodeScanner.MainPage">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Label Text="📦 QR Scanner"
                   FontSize="28"
                   FontAttributes="Bold"
                   HorizontalOptions="Center" />

            <Label Text="انبار هفت الماس"
                   FontSize="14"
                   TextColor="Gray"
                   HorizontalOptions="Center" />
            <Label
                Text="QR را در مرکز کادر قرار دهید"
                FontSize="12"
                HorizontalOptions="Center"
                TextColor="Gray" />
            
            <Frame CornerRadius="15"
                   Padding="5"
                   HasShadow="True">

                <zxing:CameraBarcodeReaderView
                    x:Name="barcodeReader"
                    HeightRequest="500"
                    HorizontalOptions="Fill"
                    VerticalOptions="Fill"
                    BarcodesDetected="BarcodesDetected" />

            </Frame>

            <Label Text="آخرین QR ثبت شده:"
                   FontAttributes="Bold" />

            <Label x:Name="resultLabel"
                   Text="-"
                   FontSize="16" />

            <Frame CornerRadius="10"
                   Padding="10"
                   HasShadow="True">

                <VerticalStackLayout Spacing="5">

                    <Label x:Name="statusLabel"
                           Text="آماده اسکن"
                           FontAttributes="Bold" />

                    <Label x:Name="countLabel"
                           Text="تعداد ثبت شده: 0" />

                </VerticalStackLayout>

            </Frame>

            <Button Text="⏹ توقف و ذخیره فایل"
                    BackgroundColor="#1976D2"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="12"
                    HeightRequest="50"
                    Clicked="StopButton_Clicked" />

            <Label Text="Haft Almas QR Coil Scanner v2.2"
                   FontSize="12"
                   HorizontalOptions="Center"
                   TextColor="Gray"/>

            <Label Text="Developed by M. Mehranpour"
                   FontSize="11"
                   HorizontalOptions="Center"
                   TextColor="Gray"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
